{
  "name": "ipa-nw-training",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "node server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "node server/index.ts",
    "training": "node server/cli.ts",
    "setup:materials": "node scripts/setup-materials.mjs",
    "test:e2e": "playwright test",
    "collect:materials": "node scripts/setup-materials.mjs scripts/collect-archive.py"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.12"
  }
}
